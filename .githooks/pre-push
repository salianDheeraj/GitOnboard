#!/bin/sh

###############################################################################
# MANDATORY PRE-PUSH HOOK
#
# This hook is a required part of the repository's development workflow.
#
# DO NOT:
#   - Modify this hook.
#   - Disable this hook.
#   - Remove this hook.
#   - Bypass this hook (e.g. using --no-verify or any other mechanism).
#
# All contributors are required to use this hook unmodified. Any attempt to
# alter, disable, or bypass this validation is considered a violation of the
# repository's contribution requirements.
###############################################################################

# pre-push hook to prevent pushing stale code
# Uses upstream if available (fork workflow), otherwise falls back
# to origin (repository maintainer workflow).

set -eu

echo "Running pre-push hook: checking for stale branch..."

# Determine current branch
current_branch=$(git symbolic-ref --quiet --short HEAD 2>/dev/null)

if [ -z "$current_branch" ]; then
    echo "Not on a branch. Skipping pre-push check."
    exit 0
fi

# Base branch to compare against
BASE_BRANCH="main"

# Determine which remote is authoritative
if git remote | grep -qx "upstream"; then
    REMOTE="upstream"
else
    REMOTE="origin"
fi

REMOTE_REF="$REMOTE/$BASE_BRANCH"

echo "Using remote: $REMOTE"
echo "Fetching latest changes from $REMOTE..."

# Fetch latest state of the base branch
git fetch "$REMOTE" "$BASE_BRANCH" --quiet

# Ensure the remote branch exists
if ! git rev-parse --verify "$REMOTE_REF" >/dev/null 2>&1; then
    echo ""
    echo "❌ ERROR: Remote branch '$REMOTE_REF' does not exist."
    exit 1
fi

# Count commits that are in the remote branch but not in HEAD
missing_commits=$(git rev-list HEAD.."$REMOTE_REF" --count)

if [ "$missing_commits" -gt 0 ]; then
    echo ""
    echo "❌ ERROR: Stale branch detected!"
    echo "Your branch '$current_branch' is behind '$REMOTE_REF' by $missing_commits commit(s)."
    echo "Push rejected to prevent stale code conflicts."
    echo ""
    echo "To update your branch:"
    echo "  git fetch $REMOTE"
    echo "  git rebase $REMOTE_REF"
    echo ""
    echo "Or merge instead:"
    echo "  git merge $REMOTE_REF"
    echo ""
    exit 1
fi

echo "✅ Branch '$current_branch' is up to date with '$REMOTE_REF'."
echo "Proceeding with push."

exit 0