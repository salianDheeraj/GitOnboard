  switch (data.mode) {
    case 'uncommitted':
      return { headline: 'No uncommitted changes', hint: null }
    case 'branch':
      if (data.source.kind === 'branch') {
        return {
          headline: `No changes vs ${data.source.baseBranch}`,
          hint: null,
        }
