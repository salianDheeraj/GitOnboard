        log.info("\n" + "=" * 80)
        log.info(f"OVERALL: {total_pass}/{total_pass + total_fail} passed")
        if total_fail == 0:
            log.info("✓ ALL TESTS PASSED - Gate enforcement working correctly")
        else:
            log.warning(f"✗ {total_fail} TESTS FAILED")
        log.info("=" * 80)


