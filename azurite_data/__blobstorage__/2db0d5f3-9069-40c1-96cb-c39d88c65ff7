        """Test creating ContextItem from ContextEvidence."""
        evidence = ContextEvidence(
            source_type="retrieval",
            source_id="symbol_1",
            relevance=0.9,
            confidence=0.85,
            summary="Test evidence",
            data={"content": "test"},
        )

        item = ContextItem.from_evidence(
