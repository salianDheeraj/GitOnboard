                "tool_calls_pct": round(((result.with_rim.retrieval_metrics.tool_call_count - result.without_rim.retrieval_metrics.tool_call_count) / max(1, result.without_rim.retrieval_metrics.tool_call_count)) * 100, 1) if result.without_rim.retrieval_metrics.tool_call_count > 0 else 0,
