   ```python
   import json
   
   with open("/tmp/failed_analysis.jsonl") as f:
       for line in f:
           action = json.loads(line)
           if action['action_type'] == 'ANALYZER_ERROR':
               print(f"Failure at: {action['message']}")
               print(f"Stack trace: {action['stack_trace']}")
