            type="PATH_ANALYSIS",
            result=path or [],
            evidence=[{"source": "ShortestPath BFS over Execution View", "start": start_node, "end": end_node}],
            metrics={
                "path_length": len(path) if path else 0
            },
            execution_time_ms=int((time.time() - start_time) * 1000)
