    # Query A: Feature exploration (holistic)
    logger.info(f"\n{'='*70}")
    logger.info("QUERY A: Feature Exploration (Holistic)")
    logger.info(f"{'='*70}")
    result_a = run_comparison_test(
        repo_name,
