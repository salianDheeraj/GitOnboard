        classification = "PASS"
    elif rim_relevant and not has_metadata:
        classification = "PARTIAL"
    elif len(results_rim) > 0:
        classification = "PARTIAL"
    else:
        classification = "FAIL"

    return {
        "query": query,
        "expected": expected_symbols,
