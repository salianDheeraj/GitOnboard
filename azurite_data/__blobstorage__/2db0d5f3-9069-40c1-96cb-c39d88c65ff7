    mock_fn2.name = "helper"
    mock_fn3 = Mock(name="unused_func", file_id="f2", module_id="m2")
    mock_fn3.name = "unused_func"
    mock_fn4 = Mock(name="api_route", file_id="f3", module_id="m3")
