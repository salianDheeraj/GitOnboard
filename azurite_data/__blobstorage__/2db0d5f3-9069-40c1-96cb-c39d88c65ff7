        path: vfsNode.path,
        isExpanded: expandedPaths.has(vfsNode.path),
        descendants: vfsNode.totalDescendants
      },
      position: positionMap.get(nodeId) || { x: 0, y: 0 },
      // Mark as newly spawned if we don't have a position
      _isNew: !positionMap.has(nodeId),
