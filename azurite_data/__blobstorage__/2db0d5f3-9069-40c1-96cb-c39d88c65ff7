                    return {
                        "response": response_text,
                        "intent": "explore",
                        "model": settings.model_terminal_explore,
                        "entities": [],
                        "evidence": [],
                    }

        # 3. Fallback: Generic Symbol & File Keyword Search (Only for unformatted generic search)
        stop_words = {
            "what", "which", "where", "how", "why", "who", "when", "show", "find", "list",
