        # STEP 2D: Summary
        logger.info(f"  Summary for {file_path}:")
        logger.info(f"    DB count: {symbol_count_db}")
        try:
            symbols_returned = len(file_info.symbols)
        except:
            symbols_returned = -1

        if symbol_count_db > 0 and symbols_returned == 0:
