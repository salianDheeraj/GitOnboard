            setLoading(false);
            return;
          }
        }
      } catch (err) {
        console.warn("Failed to fetch available repos:", err);
      }
      setValidatedRepo("default");
      setLoading(false);
    }

    validateOrFetchRepo();
  }, [repoName, router]);

  if (loading) {
    return (
      <div className="h-screen w-screen bg-[#0A0D10] text-[#E6EDF3] flex items-center justify-center font-mono text-sm">
