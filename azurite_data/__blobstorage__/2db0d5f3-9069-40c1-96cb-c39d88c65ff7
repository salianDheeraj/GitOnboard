    # 1. Metrics
    mock_analyses.metrics = {
        "test_coverage_approx_percent": 80.0,
        "documentation_coverage_percent": 90.0,
        "average_functions_per_module": 15.0, # 5 over limit -> 10 penalty
        "largest_files": [{"size": 25000}] # 1 huge file -> 5 penalty
    }
    
    # 2. Architecture
