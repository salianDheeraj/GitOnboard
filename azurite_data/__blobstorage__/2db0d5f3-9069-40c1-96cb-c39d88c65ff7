class BFS:
    @staticmethod
    def traverse(view: VirtualView, start_node: str, visitor: Callable[[str], None] = None) -> Set[str]:
        visited = set()
        queue = [start_node]
        
        while queue:
            curr = queue.pop(0)
            if curr not in visited:
                visited.add(curr)
                if visitor:
                    visitor(curr)
                    
