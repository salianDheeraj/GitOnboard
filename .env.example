# ==============================================================================
# Repository Intelligence Platform — Environment Configuration Template
# ==============================================================================
# Copy this file to .env before starting the application:
#   cp .env.example .env
#
# Sections:
#   1. Application & Deployment Mode
#   2. Database Configuration (PostgreSQL)
#   3. Frontend URLs & CORS
#   4. Security & JWT Configuration
#   5. GitHub OAuth Integration
#   6. Blob Storage (Azurite / Azure Blob Storage)
#   7. AI & LLM Providers (OpenRouter, NVIDIA, Ollama, Gemini)
#   8. Summary Pipeline & Verbose Audit Logging
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Application & Deployment Mode
# ------------------------------------------------------------------------------
# Deployment target: LOCAL (development with local services) or PROD (deployed cloud)
DEPLOYMENT_TYPE=LOCAL

# Environment identifier (development | staging | production)
ENVIRONMENT=development

# Application display name
APP_NAME=Repository Intelligence Platform


# ------------------------------------------------------------------------------
# 2. Database Configuration (PostgreSQL + Psycopg3)
# ------------------------------------------------------------------------------
# Local development database URL (when running FastAPI directly on host machine)
LOCAL_DATABASE_URL=postgresql+psycopg://myuser:mypassword@localhost:5432/repository_intelligence

# Docker container database URL (when backend runs inside docker-compose network)
DATABASE_URL=postgresql+psycopg://myuser:mypassword@postgres:5432/repository_intelligence

# Production database URL (used automatically when DEPLOYMENT_TYPE=PROD)
# PROD_DATABASE_URL=postgresql+psycopg://user:password@your-production-db-host:5432/repository_intelligence


# ------------------------------------------------------------------------------
# 3. Frontend URLs & CORS Redirects
# ------------------------------------------------------------------------------
# Local Next.js frontend URL
LOCAL_FRONTEND_URL=http://localhost:3000

# Production frontend URL (used for OAuth redirect callbacks when DEPLOYMENT_TYPE=PROD)
# PROD_FRONTEND_URL=https://your-production-domain.com


# ------------------------------------------------------------------------------
# 4. Security & JWT Configuration
# ------------------------------------------------------------------------------
# Secret key used to sign and verify JSON Web Tokens (JWT).
# Generate a strong 256-bit secret (e.g. openssl rand -hex 32 or python -c "import secrets; print(secrets.token_urlsafe(48))")
JWT_SECRET=change_me_to_a_secure_random_secret_in_production

# JWT algorithm (default: HS256)
JWT_ALGORITHM=HS256

# JWT token expiration time in minutes (default: 1440 = 24 hours)
JWT_EXPIRE_MINUTES=1440


# ------------------------------------------------------------------------------
# 5. GitHub OAuth Integration
# ------------------------------------------------------------------------------
# Register a GitHub OAuth App under GitHub Settings -> Developer settings -> OAuth Apps:
#   Homepage URL: http://localhost:3000
#   Authorization callback URL: http://localhost:8000/api/auth/callback
GITHUB_CLIENT_ID=your_github_oauth_client_id_here
GITHUB_CLIENT_SECRET=your_github_oauth_client_secret_here


# ------------------------------------------------------------------------------
# 6. Object Storage (Azure Blob Storage / Azurite Emulator)
# ------------------------------------------------------------------------------
# Default Azurite local emulator credentials (used for local testing)
AZURE_STORAGE_ACCOUNT_NAME=devstoreaccount1
AZURE_STORAGE_ACCOUNT_KEY=Eby8vdM02xNOcqFlqUwJPLlmEtlCDXJ1OUzFT50uSRZ6IFsuFq2UVErCz4I6tq/K1SZFPTOtr/KBHBeksoGMGw==
AZURE_STORAGE_CONTAINER=gitonboard-repos

# Azurite endpoint:
#   - For host-run backend: http://localhost:10100/devstoreaccount1
#   - For docker-run backend: http://azurite:10000/devstoreaccount1
AZURE_STORAGE_ENDPOINT=http://localhost:10100/devstoreaccount1

# Production Azure Blob Storage connection string (optional - overrides above if set)
# AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=myacc;AccountKey=mykey;EndpointSuffix=core.windows.net


# ------------------------------------------------------------------------------
# 7. AI & LLM Providers (Priority Fallback Chain: OpenRouter -> NVIDIA -> Ollama)
# ------------------------------------------------------------------------------
# OpenRouter API Key (Optional — Primary cloud provider if provided)
OPENROUTER_API_KEY=

# NVIDIA NIM API Key (Optional — Secondary cloud provider if provided)
NVIDIA_API_KEY=

# Google Gemini API Key (Optional)
GEMINI_API_KEY=

# Ollama local/container endpoint (Fallback provider):
#   - For host-run backend: http://localhost:11434
#   - For docker-run backend: http://host.docker.internal:11434
OLLAMA_BASE_URL=http://localhost:11434

# Default Ollama model name
OLLAMA_MODEL=qwen2.5-coder:7b

# Ollama request timeout in seconds
OLLAMA_TIMEOUT=300.0


# ------------------------------------------------------------------------------
# 8. Summary Pipeline & Verbose Audit Logging
# ------------------------------------------------------------------------------
# When enabled (true), the V2 summary pipeline writes 11 complete audit artifacts
# into evaluation/runs/<run_id>/ with automated secret redaction for debugging.
# Set to false in production.
SUMMARY_VERBOSE_AUDIT=false
